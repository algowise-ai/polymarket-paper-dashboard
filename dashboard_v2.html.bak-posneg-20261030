function filteredBooks() {
  const isWallet = (DATA.page === "wallet");
  let books = DATA.books.filter(b => isWallet ? true : !b.empty);
  if (viewMode === "live") books = books.filter(b => (b.status || "live") === "live");
  else if (viewMode === "paused") books = books.filter(b => (b.status || "") === "paused");
  else if (viewMode === "archived") books = books.filter(b => (b.status || "") === "archived");
  if (search) {
    const q = search.toLowerCase();
    books = books.filter(b => b.label.toLowerCase().includes(q) || b.id.toLowerCase().includes(q));
  }
  if (pfFilter !== "all") books = books.filter(b => (Array.isArray(b.portfolios) && b.portfolios.length) ? b.portfolios.map(String).includes(String(pfFilter)) : String(b.portfolio || "") === String(pfFilter));
  if (coinFilter !== "all") books = books.filter(b => (b.coin || "") === coinFilter);
  if (mktWinFilter !== "all") books = books.filter(b => (b.mkt_window || "") === mktWinFilter);
  if (limitFilter !== "all") books = books.filter(b => String(b.limit_c || "") === String(limitFilter));
  if (dwTypeFilter !== "all") books = books.filter(b => {
    const t = b.dw_type || (String(b.id||"").includes("_rev_") ? "Reverse" : (String(b.id||"").startsWith("dual_wing_") ? "Normal" : ""));
    return t === dwTypeFilter;
  });
  if (dwStratFilter !== "all") books = books.filter(b => {
    let s = b.dw_strategy || "";
    if (!s) {
      const mm = String(b.id||"").match(/_b([123])$/);
      if (mm) s = "B-" + mm[1];
    }
    return s === dwStratFilter;
  });
  books = books.slice().sort((a, b) => {
    const ma = a.metrics[currentWindow] || {};
    const mb = b.metrics[currentWindow] || {};
    let va, vb;
    if (sortKey === "label") { va = a.label || ""; vb = b.label || ""; }
    else if (sortKey === "portfolio") {
      va = (Array.isArray(a.portfolios) && a.portfolios.length) ? a.portfolios.join("+") : (a.portfolio || "");
      vb = (Array.isArray(b.portfolios) && b.portfolios.length) ? b.portfolios.join("+") : (b.portfolio || "");
    }
    else if (sortKey === "status") {
      const st = (x) => x.status || (x.archived ? "archived" : (x.paused || x.new_entries === false ? "paused" : "live"));
      va = st(a); vb = st(b);
    } else { va = ma[sortKey]; vb = mb[sortKey]; }
    if (typeof va === "string" || typeof vb === "string") {
      va = String(va == null ? "" : va);
      vb = String(vb == null ? "" : vb);
      return sortOrder === "asc" ? va.localeCompare(vb) : vb.localeCompare(va);
    }
    if (va == null) va = sortOrder === "asc" ? Infinity : -Infinity;
    if (vb == null) vb = sortOrder === "asc" ? Infinity : -Infinity;
    return sortOrder === "asc" ? (va - vb) : (vb - va);
