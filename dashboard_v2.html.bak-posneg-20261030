<style>
  :root {
    --bg: #0f1419;
    --panel: #1a2332;
    --border: #2a3544;
    --text: #e7ecf3;
    --muted: #8b9bb4;
    --green: #3dd68c;
    --red: #f07178;
    --amber: #e6b450;
    --blue: #59c2ff;
    --accent: #7aa2f7;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg); color: var(--text); line-height: 1.45;
  }
  header {
    padding: 16px 20px; border-bottom: 1px solid var(--border);
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
    position: sticky; top: 0; background: rgba(15,20,25,0.95); backdrop-filter: blur(8px); z-index: 20;
  }
  h1 { font-size: 18px; margin: 0; font-weight: 600; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .badge {
    display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600;
    background: #243044; color: var(--amber); border: 1px solid var(--border);
  }
  .badge.pause { color: var(--red); }
  .badge.archived { color: #fdba74; }
  .badge.live { color: var(--green); }
  .meta { color: var(--muted); font-size: 12px; }
  .subnav { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-top:8px; }
  .subnav .subnav-label { color: var(--muted); font-size: 11px; font-weight:600; margin-right:2px; }
  .subnav a.subtab {
    display:inline-block; padding:5px 12px; border-radius:999px; font-size:12px; font-weight:650;
    border:1px solid var(--border); background: var(--panel); color: var(--muted); text-decoration:none;
  }
  .subnav a.subtab:hover { border-color: var(--blue); color: var(--blue); text-decoration:none; }
  .subnav a.subtab.on {
    border-color: var(--blue); color: var(--text); background: rgba(89,194,255,.12);
  }
  .subnav a.subtab[data-pf] { cursor: pointer; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  select, input[type="search"], button.btn {
    background: var(--panel); color: var(--text); border: 1px solid var(--border);
    border-radius: 8px; padding: 7px 10px; font-size: 13px;
  }
  button.btn { cursor: pointer; }
  button.btn:hover { border-color: var(--blue); color: var(--blue); }
  input[type="search"] { min-width: 180px; }
  main { padding: 16px 20px 40px; max-width: 1400px; margin: 0 auto; }
  .summary {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(148px, 1fr)); gap: 10px; margin-bottom: 16px;
  }
  .stat {
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 12px;
  }
  .stat .k { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .stat .v { font-size: 20px; font-weight: 650; margin-top: 4px; font-variant-numeric: tabular-nums; }
  .pos { color: var(--green); }
  .neg { color: var(--red); }
  table.books {
    width: 100%; border-collapse: collapse; background: var(--panel);
    border: 1px solid var(--border); border-radius: 10px; overflow: hidden; font-size: 13px;
  }
  table.books th, table.books td {
    padding: 9px 10px; text-align: right; border-bottom: 1px solid var(--border);
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  table.books th { text-align: right; color: var(--muted); font-weight: 600; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.03em; cursor: pointer; user-select: none; background: #152032; }
  table.books th.name, table.books td.name { text-align: left; }
  table.books th.pf, table.books td.pf { text-align: left; color: var(--muted); font-variant-numeric: tabular-nums; width: 3.2em; }
  table.books th.trades, table.books td.trades { text-align: center; cursor: default; }
  table.books tr.book-row { cursor: pointer; }
  table.books tr.book-row:hover td { background: #1e2a3d; }
  table.books tr.active td { background: #243044; }
  table.books th.sort-asc::after { content: " \25B2"; font-size: 9px; }
  table.books th.sort-desc::after { content: " \25BC"; font-size: 9px; }
  .trades-link {
    display: inline-flex; align-items: center; gap: 4px;
    color: var(--blue); text-decoration: none; font-size: 12px; font-weight: 600;
    padding: 2px 8px; border-radius: 6px; border: 1px solid transparent;
  }
  .trades-link:hover { border-color: var(--blue); background: rgba(89,194,255,.08); }
  .cards {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 14px; margin-top: 18px;
  }
  .card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px;
  }
  .card h3 { margin: 0 0 6px; font-size: 14px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .card .row { display: flex; flex-wrap: wrap; gap: 10px 14px; font-size: 12px; color: var(--muted); margin-bottom: 8px; }
  .card .row strong { color: var(--text); font-weight: 600; }
  .chart-wrap { position: relative; height: 160px; }
  .chart-wrap.large { height: 280px; margin: 10px 0 4px; }
  .dual-wing-section {
    margin-top: 28px; padding: 16px 16px 8px; background: var(--panel);
    border: 1px solid var(--border); border-radius: 12px;
  }
  .dual-wing-section h2 { margin: 0 0 4px; font-size: 16px; font-weight: 650; }
  .dual-wing-head { display:flex; flex-wrap:wrap; gap:8px 16px; align-items:baseline; justify-content:space-between; margin-bottom: 10px; }
  .chart-wrap.dual-wing-combined { height: 340px; margin: 8px 0 14px; }
  .dual-wing-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin-top: 4px;
  }
  .dual-wing-mini {
    background: #152032; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px;
  }
  .dual-wing-mini h4 { margin: 0 0 4px; font-size: 12px; font-weight: 650; display:flex; justify-content:space-between; gap:8px; flex-wrap:wrap; }
  .dual-wing-mini .row { font-size: 11px; color: var(--muted); margin-bottom: 6px; display:flex; flex-wrap:wrap; gap:8px 12px; }
  .dual-wing-mini .chart-wrap { height: 110px; }
  .dual-wing-foot { margin: 12px 0 4px; }
  .memb-section { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--border); }
  .memb-section h2 { margin: 0 0 4px; font-size: 16px; font-weight: 650; }
  .memb-section .memb-head { display:flex; flex-wrap:wrap; gap:8px 16px; align-items:baseline; justify-content:space-between; margin-bottom: 10px; }
  .memb-box { margin-top: 4px; }
  .memb-box h3 { margin: 14px 0 8px; font-size: 13px; font-weight: 600; color: var(--text); }
  .memb-box h3:first-of-type { margin-top: 0; }
  .memb-empty { color: var(--muted); font-size: 13px; padding: 8px 0 4px; }
  .memb-box table.books td.l, .memb-box table.books th.l { text-align: left; }
  .chart-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 8px; margin-left: auto;
    border: 1px solid var(--border); color: var(--muted); background: transparent;
    cursor: pointer; padding: 0; flex-shrink: 0;
    transition: color .15s, border-color .15s, background .15s;
  }
  .chart-icon:hover { color: var(--blue); border-color: var(--blue); background: rgba(89,194,255,.08); }
  .chart-icon svg { width: 15px; height: 15px; display: block; }
  footer { color: var(--muted); font-size: 11px; padding: 20px; text-align: center; }
  .pub-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 8px;
    border: 1px solid var(--border); color: var(--muted); text-decoration: none;
    transition: color .15s, border-color .15s, background .15s;
  }
  .pub-link:hover { color: var(--blue); border-color: var(--blue); background: rgba(59,130,246,.08); }
  .pub-link svg { width: 14px; height: 14px; display: block; }
  a { color: var(--blue); }
  .hidden { display: none !important; }
  #detailView {
    background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px;
  }
  #detailView .detail-head {
    display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between;
    margin-bottom: 12px;
  }
  #detailView h2 { margin: 0; font-size: 16px; font-weight: 650; }
  #detailMeta { color: var(--muted); font-size: 12px; margin-bottom: 10px; }
  .detail-filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 10px; }
  table.trades {
    width: 100%; border-collapse: collapse; font-size: 12px;
    border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
  }
  table.trades th, table.trades td {
    padding: 7px 8px; text-align: left; border-bottom: 1px solid var(--border);
    font-variant-numeric: tabular-nums; vertical-align: top;
  }
  table.trades th {
    background: #152032; color: var(--muted); font-size: 10px; text-transform: uppercase;
    letter-spacing: 0.03em; position: sticky; top: 0; z-index: 1;
  }
  table.trades td.num { text-align: right; white-space: nowrap; }
  table.trades td.market { max-width: 280px; white-space: normal; word-break: break-word; }
  .trades-scroll { max-height: min(70vh, 720px); overflow: auto; border-radius: 8px; }
  .status-pill {
    display: inline-block; padding: 1px 7px; border-radius: 999px; font-size: 10px; font-weight: 650;
    border: 1px solid var(--border); text-transform: uppercase;
  }
  .status-pill.open { color: var(--amber); }
  .status-pill.settled { color: var(--green); }
  @media (max-width: 640px) {
    table.trades td.market { max-width: 160px; }
    .card { min-width: 0; }
  }
</style>
