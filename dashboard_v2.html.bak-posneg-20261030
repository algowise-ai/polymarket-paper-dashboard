function fmtMoney(n) {
  if (n == null || Number.isNaN(n)) return "—";
  const sign = n > 0 ? "+" : "";
  return sign + "$" + n.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
}
function fmtPct(n) {
  if (n == null || Number.isNaN(n)) return "—";
  return n.toFixed(1) + "%";
}
function fmtPrice(n) {
  if (n == null || Number.isNaN(n)) return "—";
  return Number(n).toFixed(3);
}
function fmtCents(n) {
  if (n == null || Number.isNaN(n)) return "—";
  const sign = n > 0 ? "+" : "";
