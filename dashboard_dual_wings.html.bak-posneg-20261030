  if (period === "cal_month") {
    const { y, m } = hktYmdParts(new Date());
    return Date.parse(y + "-" + m + "-01T00:00:00+08:00");
  }
  // legacy aliases
  if (period === "today") {
    const { y, m, d } = hktYmdParts(new Date());
    return Date.parse(y + "-" + m + "-" + d + "T00:00:00+08:00");
  }
