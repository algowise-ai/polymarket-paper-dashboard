  if (period === "30d") return now - 30 * dayMs;
  const mDay = /^(\d+)d$/.exec(period);
  if (mDay) return now - parseInt(mDay[1], 10) * dayMs;
  const mWeek = /^(\d+)w$/.exec(period);
  if (mWeek) return now - parseInt(mWeek[1], 10) * 7 * dayMs;
  const mMonth = /^(\d+)m$/.exec(period);
  if (mMonth) return now - parseInt(mMonth[1], 10) * 30 * dayMs;
  return null;
}
