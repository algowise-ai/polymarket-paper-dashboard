function walletLifetimePnl() {
  // Portfolio-level: (current members equity − bankroll) + Σ exit holding-period paper_pnl.
  // Independent of coin/search/view filters; follows Portfolio chip (All / 01–04). PAPER ONLY.
  if (DATA.page !== "wallet") return null;
  const pf = (typeof pfFilter !== "undefined" && pfFilter) ? String(pfFilter) : "all";
  const pids = (pf === "all") ? ["01", "02", "03", "04", "05", "06"] : [pf];
  const seen = new Set();
  let currentPnl = 0;
  let nCur = 0;
  for (const b of (DATA.books || [])) {
    const pfs = (Array.isArray(b.portfolios) && b.portfolios.length)
      ? b.portfolios.map(String)
      : [String(b.portfolio || "")];
    const match = (pf === "all") ? true : pfs.includes(pf);
    if (!match) continue;
    if (seen.has(b.id)) continue;
    seen.add(b.id);
    const m = (b.metrics && (b.metrics.all || b.metrics.cal_month || b.metrics[currentWindow])) || {};
    const eq = (m.equity != null) ? Number(m.equity) : 0;
    const br = (b.bankroll != null) ? Number(b.bankroll) : 100;
    currentPnl += eq - br;
    nCur += 1;
  }
  let exitPnl = 0;
  let nEx = 0;
  const funds = ((DATA.membership_changes || {}).funds) || {};
  for (const pid of pids) {
    const block = funds[pid] || {};
    if (block.sum_exit_paper_pnl_usd != null && block.n_exits_with_pnl != null) {
      exitPnl += Number(block.sum_exit_paper_pnl_usd) || 0;
      nEx += Number(block.n_exits_with_pnl) || 0;
    } else {
      for (const r of (block.exits || [])) {
        if (r.paper_pnl_usd == null) continue;
        exitPnl += Number(r.paper_pnl_usd) || 0;
        nEx += 1;
      }
    }
  }
  return {
    currentPnl, exitPnl, lifetime: currentPnl + exitPnl, nCur, nEx, pf
  };
}
