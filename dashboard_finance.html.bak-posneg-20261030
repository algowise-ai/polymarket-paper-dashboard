}
function periodCutoffMs(period) {
  if (!period || period === "all") return null;
  const now = Date.now();
  const dayMs = 24 * 3600 * 1000;
  if (period === "cal_month") {
    const { y, m } = hktYmdParts(new Date());
    return Date.parse(y + "-" + m + "-01T00:00:00+08:00");
  }
  // legacy aliases
  if (period === "today") {
    const { y, m, d } = hktYmdParts(new Date());
    return Date.parse(y + "-" + m + "-" + d + "T00:00:00+08:00");
  }
  if (period === "7d") return now - 7 * dayMs;
  if (period === "30d") return now - 30 * dayMs;
  const mDay = /^(\d+)d$/.exec(period);
  if (mDay) return now - parseInt(mDay[1], 10) * dayMs;
  const mWeek = /^(\d+)w$/.exec(period);
  if (mWeek) return now - parseInt(mWeek[1], 10) * 7 * dayMs;
  const mMonth = /^(\d+)m$/.exec(period);
  if (mMonth) return now - parseInt(mMonth[1], 10) * 30 * dayMs;
  return null;
}
