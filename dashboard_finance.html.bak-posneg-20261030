      'html[data-theme-resolved="light"] .topbar{background:rgba(247,249,252,.92)!important;border-bottom-color:var(--border)!important;color:var(--text)!important;}',
      'html[data-theme-resolved="light"] table{border-color:var(--border)!important;}',
      'html[data-theme-resolved="light"] th,html[data-theme-resolved="light"] td{border-bottom-color:var(--border-soft)!important;}',
      'html[data-theme-resolved="light"] th{background:var(--header-bg)!important;}',
      'html[data-theme-resolved="light"] code{background:var(--code-bg)!important;color:var(--text)!important;}',
      'html[data-theme-resolved="light"] .card{border-color:var(--border)!important;box-shadow:var(--shadow)!important;}',
      'html[data-theme-resolved="light"] .card.sub{background:var(--panel)!important;}',
      'html[data-theme-resolved="light"] .card.goal{border-color:#93c5fd!important;background:linear-gradient(165deg,#e8f0fc 0%,var(--card) 55%)!important;}',
      'html[data-theme-resolved="light"] .kpi,html[data-theme-resolved="light"] .mcard,html[data-theme-resolved="light"] .aspect-update,html[data-theme-resolved="light"] .ring-inner,html[data-theme-resolved="light"] .bar,html[data-theme-resolved="light"] .stack{background:var(--inset)!important;border-color:var(--border-soft)!important;}',
      'html[data-theme-resolved="light"] .ring{box-shadow:inset 0 0 0 1px var(--border)!important;}',
      'html[data-theme-resolved="light"] .chip{background:var(--chip-bg)!important;border-color:var(--border)!important;}',
      'html[data-theme-resolved="light"] .chip.ok{background:#d1fae5!important;color:#047857!important;border-color:#a7f3d0!important;}',
      'html[data-theme-resolved="light"] .chip.warn{background:#fef3c7!important;color:#b45309!important;border-color:#fde68a!important;}',
      'html[data-theme-resolved="light"] .chip.bad{background:#fee2e2!important;color:#b91c1c!important;border-color:#fecaca!important;}',
      'html[data-theme-resolved="light"] .chip.muted{background:var(--panel)!important;color:var(--muted)!important;border-color:var(--border-soft)!important;}',
      'html[data-theme-resolved="light"] .chip.item{background:var(--card)!important;border-color:var(--border)!important;color:var(--text)!important;}',
      'html[data-theme-resolved="light"] .badge.local{background:#d1fae5!important;color:#047857!important;}',
      'html[data-theme-resolved="light"] .badge.public{background:#dbeafe!important;color:#1d4ed8!important;}',
      'html[data-theme-resolved="light"] .pill{background:var(--chip-bg)!important;color:var(--accent)!important;}',
      'html[data-theme-resolved="light"] .tab-bar{background:var(--surface)!important;border-color:var(--border)!important;}',
      'html[data-theme-resolved="light"] .tab-btn.aspect-general{--tab-fg:#111;--tab-soft:rgba(17,17,17,.08);}',
      'html[data-theme-resolved="light"] .tab-btn.aspect-trading{--tab-fg:#5b21b6;--tab-soft:rgba(139,92,246,.14);}',
      'html[data-theme-resolved="light"] .tab-btn.aspect-work{--tab-fg:#1d4ed8;--tab-soft:rgba(59,130,246,.14);}',
      'html[data-theme-resolved="light"] details.daily-fold,html[data-theme-resolved="light"] details.hist-fold{border-color:var(--border)!important;}',
      'html[data-theme-resolved="light"] table.bots tr.manager-row{background:#e8f0fc!important;}',
      'html[data-theme-resolved="light"] table.bots tr.manager-row td{border-bottom-color:#93c5fd!important;}',
      'html[data-theme-resolved="light"] table.bots tr.aspect-group td{background:var(--header-bg)!important;border-bottom-color:var(--border)!important;}',
      'html[data-theme-resolved="light"] .col-hl h4{color:#047857!important;}',
      'html[data-theme-resolved="light"] .col-deliv h4{color:#1d4ed8!important;}',
      /* Theme chrome — subtle elevation, not muddy blobs */
      '#algowise-theme-root{position:fixed;top:12px;right:12px;z-index:99999;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif;}',
      '#algowise-theme-btn{width:38px;height:38px;border-radius:11px;border:1px solid var(--border,#243044);background:var(--card,#1a2332);color:var(--text,#e7ecf3);',
      'display:inline-flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--shadow-md);padding:0;}',
      '#algowise-theme-btn:hover{border-color:var(--accent,#3d8bfd);}',
      '#algowise-theme-menu{display:none;position:absolute;right:0;top:44px;min-width:132px;background:var(--card,#1a2332);border:1px solid var(--border,#243044);',
      'border-radius:12px;padding:6px;box-shadow:var(--shadow-lg);}',
      '#algowise-theme-root.open #algowise-theme-menu{display:block;}',
      '#algowise-theme-menu button{display:flex;width:100%;align-items:center;gap:8px;border:0;background:transparent;color:var(--text,#e7ecf3);',
      'padding:8px 10px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;text-align:left;}',
      '#algowise-theme-menu button:hover{background:var(--surface,#0b1220);}',
      '#algowise-theme-menu button[aria-checked="true"]{color:var(--accent,#3d8bfd);}',
      '@media (max-width:640px){#algowise-theme-root{top:8px;right:8px;}#algowise-theme-btn{width:34px;height:34px;}}'
    ].join("");
    document.head.appendChild(css);
  }
  function ensureUi() {
    if (document.getElementById("algowise-theme-root")) return;
    var root = document.createElement("div");
    root.id = "algowise-theme-root";
    root.innerHTML =
      '<button type="button" id="algowise-theme-btn" aria-haspopup="menu" aria-expanded="false"></button>' +
      '<div id="algowise-theme-menu" role="menu">' +
      '<button type="button" role="menuitemradio" data-mode="light" aria-checked="false">' + ICONS.light + " Light</button>" +
      '<button type="button" role="menuitemradio" data-mode="dark" aria-checked="false">' + ICONS.dark + " Dark</button>" +
      '<button type="button" role="menuitemradio" data-mode="system" aria-checked="false">' + ICONS.system + " System</button>" +
      "</div>";
    document.body.appendChild(root);
    var btn = document.getElementById("algowise-theme-btn");
    var menu = document.getElementById("algowise-theme-menu");
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var open = root.classList.toggle("open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
    menu.addEventListener("click", function (e) {
      var t = e.target.closest("[data-mode]");
      if (!t) return;
      apply(t.getAttribute("data-mode"));
      root.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    });
    document.addEventListener("click", function () {
      root.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    });
    btn.addEventListener("contextmenu", function (e) {
      e.preventDefault();
      apply(nextMode(readMode()));
    });
  }
  function boot() {
    ensureCss();
    ensureUi();
    apply(readMode());
  }
  try {
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
      if (readMode() === "system") apply("system");
    });
  } catch (e) {}
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();

</script>
</body>
</html>
