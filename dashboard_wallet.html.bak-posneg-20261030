async function loadTradesForBook(book) {
  const embedded = Array.isArray(book.trades) ? book.trades.slice() : [];
  const wantFull = !!book.trades_truncated || (book.trades_total != null && embedded.length < book.trades_total);
  if (wantFull && book.trades_file) {
    try {
      const url = book.trades_file + (book.trades_file.indexOf("?") >= 0 ? "&" : "?") + "t=" + encodeURIComponent(DATA.generated_utc || "");
      const resp = await fetch(url, { cache: "no-store" });
      if (resp.ok) {
        const j = await resp.json();
        if (j && Array.isArray(j.trades)) {
          return { trades: j.trades, source: "file", total: j.trades_total != null ? j.trades_total : j.trades.length };
        }
      }
    } catch (e) { /* file:// fallback */ }
  }
  return {
    trades: embedded,
    source: book.trades_truncated ? "embed_truncated" : "embed",
    total: book.trades_total != null ? book.trades_total : embedded.length
