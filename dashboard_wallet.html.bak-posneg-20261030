function parseTradeMs(raw) {
  if (!raw) return null;
  const ms = Date.parse(raw);
  return Number.isFinite(ms) ? ms : null;
}
const TRADE_PERIOD_KEYS = new Set([
  "cal_month","1d","2d","3d","4d","5d","1w","2w","3w","1m","2m","3m","all"
]);
function hktYmdParts(date) {
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: "Asia/Hong_Kong",
    year: "numeric", month: "2-digit", day: "2-digit"
  }).formatToParts(date || new Date());
  return {
    y: parts.find(p => p.type === "year").value,
    m: parts.find(p => p.type === "month").value,
    d: parts.find(p => p.type === "day").value
  };
}
function periodCutoffMs(period) {
  if (!period || period === "all") return null;
  const now = Date.now();
  const dayMs = 24 * 3600 * 1000;
  if (period === "cal_month") {
    const { y, m } = hktYmdParts(new Date());
    return Date.parse(y + "-" + m + "-01T00:00:00+08:00");
  }
  // legacy aliases
  if (period === "today") {
    const { y, m, d } = hktYmdParts(new Date());
    return Date.parse(y + "-" + m + "-" + d + "T00:00:00+08:00");
  }
  if (period === "7d") return now - 7 * dayMs;
  if (period === "30d") return now - 30 * dayMs;
  const mDay = /^(\d+)d$/.exec(period);
  if (mDay) return now - parseInt(mDay[1], 10) * dayMs;
  const mWeek = /^(\d+)w$/.exec(period);
  if (mWeek) return now - parseInt(mWeek[1], 10) * 7 * dayMs;
  const mMonth = /^(\d+)m$/.exec(period);
  if (mMonth) return now - parseInt(mMonth[1], 10) * 30 * dayMs;
  return null;
}
function tradeInPeriod(t, cutoff) {
  if (cutoff == null) return true;
  const o = parseTradeMs(t.opened_at);
  const s = parseTradeMs(t.settled_at);
  if (o != null && o >= cutoff) return true;
  if (s != null && s >= cutoff) return true;
  return false;
}
